{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "cricket-api",

  "main": "src/index.ts",

  "compatibility_date": "2026-08-08",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  // The frontend's NEXT_PUBLIC_API_URL points at :5000, not wrangler's 8787.
  "dev": {
    "port": 5000
  },

  // Wrangler's bundler resolves `@prisma/client` to the browser stub, which
  // throws "PrismaClient is not configured to run in Cloudflare Workers".
  // Point it at the generated WASM engine build instead (driver adapters).
  "alias": {
    "@prisma/client": "./node_modules/.prisma/client/wasm.js"
  }
}