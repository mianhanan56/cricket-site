# ============================================================================
# CREX Clone — environment variables
# Copy to `.env` (root) and fill in. Never commit real secrets.
# ============================================================================

# --- Backend (Express) ------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL via Prisma) ---------------------------------------
# For serverless Postgres (e.g. Neon) add &connect_timeout=15 — scale-to-zero
# computes cold-start slower than Prisma's 5s default connect timeout.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# --- Redis (cache) ----------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth (NextAuth + JWT) --------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Cricket data (CricLive via our Cloudflare Worker) ----------------------
# The backend holds NO cricket credentials — it calls the Worker, which owns the
# CricLive token as a Wrangler secret. See /worker.
CRICKET_WORKER_URL="https://pulsecrease-cricket.pulse-cricket.workers.dev"

# Runaway-loop backstop on daily upstream calls (not a plan limit). Optional.
CRICKET_DAILY_CALL_LIMIT=10000

# --- Frontend (Next.js, must be prefixed NEXT_PUBLIC_) ----------------------
NEXT_PUBLIC_API_URL="http://localhost:5000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"
# Browser talks to the Worker directly for live miniscore / match facts.
NEXT_PUBLIC_CRICKET_WORKER_URL="https://pulsecrease-cricket.pulse-cricket.workers.dev"
