{
  "name": "@pulsecrease/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker — edge proxy + cache in front of the upstream's internal APIs",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "probe": "./scripts/probe.sh",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --alias:cloudflare:workers=./tests/stubs/cloudflare-workers.ts --outdir=.wrangler/tests --log-level=warning && node --test \".wrangler/tests/*.test.js\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.4.0",
    "wrangler": "^4.120.0"
  }
}
